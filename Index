<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="TXG Maker Info - Premium & Secure Bot Maker and Reliable Hosting for Telegram">
  <title>TXG Maker Info - Premium Telegram Bot Services</title>
  <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    
    :root {
      --primary: #ffd700;
      --primary-light: #ffed4e;
      --primary-dark: #e6c200;
      --dark: #0f172a;
      --dark-light: #1e293b;
      --text: #f8fafc;
      --text-light: #cbd5e1;
    }
    
    body {
      font-family: 'Poppins', sans-serif;
      background: linear-gradient(135deg, var(--dark), var(--dark-light));
      color: var(--text);
      overflow-x: hidden;
      line-height: 1.6;
    }
    
    /* Animated gradient background */
    .animated-bg {
      position: fixed;
      top: 0; left: 0;
      width: 100%; height: 100%;
      z-index: -1;
      background: 
        radial-gradient(circle at 10% 20%, rgba(255, 215, 0, 0.15), transparent 20%),
        radial-gradient(circle at 80% 80%, rgba(255, 179, 71, 0.1), transparent 25%),
        radial-gradient(circle at 50% 50%, rgba(250, 204, 21, 0.1), transparent 30%);
      background-size: 200% 200%;
      animation: moveGradient 20s ease infinite;
    }
    
    @keyframes moveGradient {
      0% { background-position: 0% 0%; }
      50% { background-position: 100% 100%; }
      100% { background-position: 0% 0%; }
    }
    
    /* Header styles */
    header { 
      text-align: center; 
      padding: 80px 20px 60px; 
      position: relative;
    }
    
    header::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 100%;
      background: radial-gradient(ellipse at center, rgba(255, 215, 0, 0.1) 0%, transparent 70%);
      z-index: -1;
    }
    
    .logo {
      width: 80px;
      height: 80px;
      margin: 0 auto 20px;
      background: linear-gradient(135deg, var(--primary), var(--primary-dark));
      border-radius: 20px;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 0 20px rgba(255, 215, 0, 0.4);
    }
    
    .logo span {
      font-weight: 700;
      font-size: 1.8rem;
      color: var(--dark);
    }
    
    header h1 { 
      font-size: 3.2rem; 
      color: var(--primary); 
      margin-bottom: 15px; 
      text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
      background: linear-gradient(to right, var(--primary), var(--primary-light));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    
    header p { 
      color: var(--text-light); 
      font-size: 1.3rem; 
      max-width: 700px; 
      margin: 0 auto 30px;
    }
    
    .tagline {
      display: inline-block;
      background: rgba(255, 215, 0, 0.1);
      padding: 8px 20px;
      border-radius: 50px;
      color: var(--primary);
      font-weight: 500;
      border: 1px solid rgba(255, 215, 0, 0.2);
    }
    
    /* Cards layout */
    .cards { 
      display: grid; 
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); 
      gap: 30px; 
      padding: 40px 20px; 
      max-width: 1400px; 
      margin: 0 auto; 
    }
    
    .card {
      background: rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      transition: all 0.4s ease;
      text-align: center;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(255, 255, 255, 0.05);
      position: relative;
    }
    
    .card::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--primary), var(--primary-dark));
    }
    
    .card:hover { 
      transform: translateY(-10px); 
      box-shadow: 0 15px 40px rgba(255, 215, 0, 0.2);
      background: rgba(255, 255, 255, 0.08);
    }
    
    .card-image {
      width: 100%; 
      height: 220px; 
      object-fit: cover; 
      display: block;
      transition: transform 0.5s ease;
    }
    
    .card:hover .card-image {
      transform: scale(1.05);
    }
    
    .card-content { 
      padding: 25px; 
      flex-grow: 1; 
      display: flex; 
      flex-direction: column; 
    }
    
    .card h2 { 
      font-size: 1.8rem; 
      margin: 15px 0 10px; 
      color: var(--primary); 
      text-shadow: 0 0 8px rgba(255, 215, 0, 0.3);
    }
    
    .card p { 
      font-size: 1rem; 
      color: var(--text-light); 
      margin-bottom: 20px; 
      flex-grow: 1; 
    }
    
    .feature-list {
      text-align: left;
      margin: 15px 0;
      padding-left: 20px;
    }
    
    .feature-list li {
      margin-bottom: 8px;
      color: var(--text-light);
      position: relative;
    }
    
    .feature-list li::before {
      content: '✓';
      color: var(--primary);
      font-weight: bold;
      position: absolute;
      left: -20px;
    }
    
    .btn {
      display: inline-block;
      margin-top: auto;
      padding: 14px 24px;
      background: linear-gradient(90deg, var(--primary), var(--primary-dark));
      color: var(--dark);
      border-radius: 12px;
      font-weight: 700;
      text-decoration: none;
      transition: all 0.3s ease;
      border: none;
      cursor: pointer;
      box-shadow: 0 5px 15px rgba(255, 215, 0, 0.3);
      position: relative;
      overflow: hidden;
    }
    
    .btn::after {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: 0.5s;
    }
    
    .btn:hover { 
      transform: translateY(-3px); 
      box-shadow: 0 8px 20px rgba(255, 215, 0, 0.5);
    }
    
    .btn:hover::after {
      left: 100%;
    }
    
    /* Footer */
    footer { 
      text-align: center; 
      padding: 40px 20px; 
      color: var(--text-light); 
      font-size: 1rem; 
      margin-top: 40px; 
      border-top: 1px solid rgba(255, 255, 255, 0.05);
      position: relative;
    }
    
    footer::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--primary), transparent);
    }
    
    /* Premium button */
    .premium { 
      position: fixed; 
      right: 30px; 
      bottom: 30px; 
      z-index: 10; 
    }
    
    .premium a {
      background: linear-gradient(90deg, var(--primary), var(--primary-dark));
      color: var(--dark);
      padding: 14px 26px;
      border-radius: 16px;
      text-decoration: none;
      font-weight: 800;
      box-shadow: 0 5px 20px rgba(255, 215, 0, 0.5);
      transition: all 0.3s ease;
      display: block;
      position: relative;
      overflow: hidden;
    }
    
    .premium a::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.4), transparent);
      transition: 0.5s;
    }
    
    .premium a:hover { 
      transform: scale(1.05); 
      box-shadow: 0 8px 25px rgba(255, 215, 0, 0.7);
    }
    
    .premium a:hover::before {
      left: 100%;
    }
    
    /* Responsive adjustments */
    @media (max-width: 768px) {
      header { padding: 60px 20px 40px; }
      header h1 { font-size: 2.5rem; }
      .cards { grid-template-columns: 1fr; padding: 20px; }
      .premium { 
        position: static; 
        text-align: center; 
        margin: 20px auto; 
      }
      .premium a {
        display: inline-block;
      }
    }
    
    /* Loading animation for images */
    .card-image {
      background: linear-gradient(90deg, #1e293b 0%, #334155 50%, #1e293b 100%);
      background-size: 200% 100%;
      animation: loading 1.5s infinite;
    }
    
    @keyframes loading {
      0% { background-position: 200% 0; }
      100% { background-position: -200% 0; }
    }
  </style>
</head>
